---
import RelatedPosts from './RelatedPosts.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  pubDate?: Date;
  excludeSlug?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, pubDate, excludeSlug, breadcrumbs } = Astro.props;

const breadcrumbTrail = breadcrumbs ?? [{ label: title }];

const formattedDate = pubDate
  ? pubDate.toLocaleDateString('nl-NL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<div
  data-elementor-type="single-post"
  data-elementor-id="36361"
  class="elementor elementor-36361 elementor-location-single"
  data-elementor-post-type="elementor_library"
>
  <section
    class="elementor-section elementor-top-section elementor-element elementor-element-5f463e97 elementor-section-boxed elementor-section-height-default elementor-section-height-default"
    data-id="5f463e97"
    data-element_type="section"
  >
    <div class="elementor-container elementor-column-gap-default">
      <div
        class="elementor-column elementor-col-66 elementor-top-column elementor-element elementor-element-4e8c20ec"
        data-id="4e8c20ec"
        data-element_type="column"
      >
        <div class="elementor-widget-wrap elementor-element-populated">
          <div
            class="elementor-element elementor-element-72c97c25 elementor-widget elementor-widget-breadcrumbs"
            data-id="72c97c25"
            data-element_type="widget"
            data-widget_type="breadcrumbs.default"
          >
            <div class="elementor-widget-container">
              <p id="breadcrumbs">
                <span>
                  <span><a href="/">Home</a></span>
                  {
                    breadcrumbTrail.map((crumb, index) => (
                      <>
                        {' '}&raquo;{' '}
                        {crumb.href && index < breadcrumbTrail.length - 1 ? (
                          <span><a href={crumb.href}>{crumb.label}</a></span>
                        ) : (
                          <span class="breadcrumb_last" aria-current="page">{crumb.label}</span>
                        )}
                      </>
                    ))
                  }
                </span>
              </p>
            </div>
          </div>
          <div
            class="elementor-element elementor-element-54080229 elementor-widget elementor-widget-theme-post-title elementor-page-title elementor-widget-heading"
            data-id="54080229"
            data-element_type="widget"
            data-widget_type="theme-post-title.default"
          >
            <div class="elementor-widget-container">
              <h1 class="elementor-heading-title elementor-size-default">{title}</h1>
            </div>
          </div>
          {
            formattedDate && (
              <div
                class="elementor-element elementor-element-59cf564b elementor-widget elementor-widget-post-info"
                data-id="59cf564b"
                data-element_type="widget"
                data-widget_type="post-info.default"
              >
                <div class="elementor-widget-container">
                  <ul class="elementor-inline-items elementor-icon-list-items elementor-post-info">
                    <li
                      class="elementor-icon-list-item elementor-repeater-item-bb4eee6 elementor-inline-item"
                      itemprop="datePublished"
                    >
                      <span class="elementor-icon-list-icon">
                        <i aria-hidden="true" class="far fa-calendar-check" />
                      </span>
                      <span class="elementor-icon-list-text elementor-post-info__item elementor-post-info__item--type-date">
                        <time datetime={pubDate!.toISOString()}>{formattedDate}</time>
                      </span>
                    </li>
                  </ul>
                </div>
              </div>
            )
          }
          <div
            class="elementor-element elementor-element-f97e369 elementor-widget elementor-widget-theme-post-content"
            data-id="f97e369"
            data-element_type="widget"
            data-widget_type="theme-post-content.default"
          >
            <div class="elementor-widget-container inner-article-content">
              <slot />
            </div>
          </div>
        </div>
      </div>
      <div
        class="elementor-column elementor-col-33 elementor-top-column elementor-element elementor-element-b535dfa"
        data-id="b535dfa"
        data-element_type="column"
      >
        <div class="elementor-widget-wrap elementor-element-populated">
          <div
            class="elementor-element elementor-element-560700d3 elementor-toc--minimized-on-tablet elementor-widget elementor-widget-table-of-contents inner-article-toc"
            data-id="560700d3"
            data-element_type="widget"
            data-widget_type="table-of-contents.default"
          >
            <div class="elementor-widget-container">
              <div class="elementor-toc__header">
                <div class="elementor-toc__header-title">Inhoud</div>
                <div
                  class="elementor-toc__toggle-button elementor-toc__toggle-button--expand"
                  role="button"
                  tabindex="0"
                  aria-expanded="true"
                  aria-label="Open inhoudsopgave"
                >
                  <i aria-hidden="true" class="fas fa-chevron-down" />
                </div>
                <div
                  class="elementor-toc__toggle-button elementor-toc__toggle-button--collapse"
                  role="button"
                  tabindex="0"
                  aria-expanded="true"
                  aria-label="Sluit inhoudsopgave"
                >
                  <i aria-hidden="true" class="fas fa-chevron-up" />
                </div>
              </div>
              <div id="elementor-toc__560700d3" class="elementor-toc__body">
                <div class="elementor-toc__spinner-container">
                  <i class="elementor-toc__spinner eicon-animation-spin eicon-loading" aria-hidden="true" />
                </div>
              </div>
            </div>
          </div>
          <div
            class="elementor-element elementor-element-14b8eef7 elementor-widget elementor-widget-heading"
            data-id="14b8eef7"
            data-element_type="widget"
            data-widget_type="heading.default"
          >
            <div class="elementor-widget-container">
              <p class="elementor-heading-title elementor-size-default">Andere artikelen</p>
            </div>
          </div>
          <div
            class="elementor-element elementor-element-696f795c elementor-grid-1 elementor-grid-tablet-2 elementor-grid-mobile-1 elementor-posts--thumbnail-top elementor-widget elementor-widget-posts"
            data-id="696f795c"
            data-element_type="widget"
            data-widget_type="posts.classic"
          >
            <div class="elementor-widget-container">
              <RelatedPosts excludeSlug={excludeSlug} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
