---
import navigation from '../data/navigation.json';

type NavItem = {
  title: string;
  url: string;
  children?: NavItem[];
};

const footerNav = (navigation.footer || navigation.header || []) as NavItem[];
const categories = (navigation.categories || []) as { slug: string; name: string }[];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-section">
      <h3>Financiële Begrippen</h3>
      <p>Honderden financiele begrippen uitgelegd</p>
    </div>
    {categories.length > 0 && (
      <div class="footer-section">
        <h3>Alfabet</h3>
        <div class="alpha-links">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}/`}>{cat.name}</a>
          ))}
        </div>
      </div>
    )}
    <div class="footer-section">
      <h3>Navigatie</h3>
      <ul>
        {footerNav.slice(0, 8).map((item) => (
          <li><a href={item.url}>{item.title}</a></li>
        ))}
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Financiële Begrippen</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #2d3748;
    color: #e2e8f0;
    margin-top: 3rem;
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }
  .footer-section h3 {
    color: white;
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-section a {
    color: #cbd5e0;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .footer-section a:hover {
    color: white;
  }
  .alpha-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .alpha-links a {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    line-height: 2rem;
    text-align: center;
    background: #4a5568;
    border-radius: 4px;
    color: white;
    text-decoration: none;
    font-weight: 600;
  }
  .alpha-links a:hover {
    background: #1a365d;
  }
  .footer-bottom {
    border-top: 1px solid #4a5568;
    text-align: center;
    padding: 1rem;
    font-size: 0.85rem;
    color: #a0aec0;
  }
</style>
