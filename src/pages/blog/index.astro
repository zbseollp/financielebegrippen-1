---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sitemapData from '../../data/sitemap-data.json';

/**
 * Posts are synced in from Payload, whose blog-posts collection has no category
 * field, so the frontmatter carries nothing to filter on. The blog set is
 * derived from the captured WordPress sitemap instead:
 *
 *   - everything in the "Categorie: BLOG" bucket, plus
 *   - every entry the snapshot does not know at all, which is exactly the
 *     content added after the migration.
 *
 * The A-Z buckets hold the glossary and the template pages below have their own
 * navigation, so neither shows up here.
 */
type SitemapLink = { title: string; href: string };
type SitemapCategory = { label: string; links: SitemapLink[] };

const categories = sitemapData.categories as SitemapCategory[];

/** Live hrefs are percent-encoded and some carry non-breaking hyphens (U+2011). */
function slugFromHref(href: string) {
  let slug = href;
  try {
    slug = decodeURIComponent(href);
  } catch {
    // keep the raw href when it is not valid percent-encoding
  }
  return slug.replace(/[‐-―]/g, '-').replace(/^\/|\/$/g, '');
}

const blogSlugs = new Set(
  (categories.find((cat) => cat.label.trim().toUpperCase().endsWith('BLOG'))?.links ?? []).map(
    (link) => slugFromHref(link.href),
  ),
);

const capturedSlugs = new Set(
  categories.flatMap((cat) => cat.links.map((link) => slugFromHref(link.href))),
);

/** Generated pages that are reached from their own menus, never from the blog. */
const TEMPLATE_PATTERNS = [
  /-euro-lenen$/,
  /-achteraf-betalen$/,
  /^aandelen-.+-kopen-of-niet$/,
  /^vermogen-van\//,
];

const posts = (await getCollection('blog'))
  .filter((entry) => {
    if (blogSlugs.has(entry.id)) return true;
    if (capturedSlugs.has(entry.id)) return false;
    return !TEMPLATE_PATTERNS.some((pattern) => pattern.test(entry.id));
  })
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    pubDate: entry.data.pubDate,
  }))
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Artikelen over financiële onderwerpen">
  <div class="blog-listing">
    <h1>Blog</h1>
    <p class="intro">Artikelen en nieuws over financiële onderwerpen.</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2>
              <a href={`/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="description">{post.description}</p>
            <time datetime={post.pubDate.toISOString()}>
              {post.pubDate.toLocaleDateString('nl-NL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-listing {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .blog-listing h1 {
    font-size: 2rem;
    color: #1a365d;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: #666;
    margin-bottom: 2rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.5rem 0;
  }
  .post-list h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .post-list h2 a {
    color: #1a365d;
    text-decoration: none;
  }
  .post-list h2 a:hover {
    text-decoration: underline;
  }
  .description {
    color: #4a5568;
    margin-bottom: 0.5rem;
  }
  time {
    font-size: 0.85rem;
    color: #888;
  }
</style>
