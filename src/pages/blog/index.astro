---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.categories?.includes('Blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Artikelen over financiële onderwerpen">
  <div class="blog-listing">
    <h1>Blog</h1>
    <p class="intro">Artikelen en nieuws over financiële onderwerpen.</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2>
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="description">{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('nl-NL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-listing {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .blog-listing h1 {
    font-size: 2rem;
    color: #1a365d;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: #666;
    margin-bottom: 2rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.5rem 0;
  }
  .post-list h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .post-list h2 a {
    color: #1a365d;
    text-decoration: none;
  }
  .post-list h2 a:hover {
    text-decoration: underline;
  }
  .description {
    color: #4a5568;
    margin-bottom: 0.5rem;
  }
  time {
    font-size: 0.85rem;
    color: #888;
  }
</style>
