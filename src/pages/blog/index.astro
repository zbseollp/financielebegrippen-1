---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import sitemapData from '../../data/sitemap-data.json';

/**
 * The migrated frontmatter lost the WordPress categories (every post ships
 * `categories: []`), so the blog set comes from the "Categorie: BLOG" bucket in
 * the captured sitemap data instead. Collection entries supply the metadata.
 */
type SitemapLink = { title: string; href: string };
type SitemapCategory = { label: string; links: SitemapLink[] };

const blogLinks =
  (sitemapData.categories as SitemapCategory[]).find((cat) =>
    cat.label.trim().toUpperCase().endsWith('BLOG'),
  )?.links ?? [];

/** Live hrefs are percent-encoded and some carry non-breaking hyphens (U+2011). */
function slugFromHref(href: string) {
  let slug = href;
  try {
    slug = decodeURIComponent(href);
  } catch {
    // keep the raw href when it is not valid percent-encoding
  }
  return slug.replace(/[‐-―]/g, '-').replace(/^\/|\/$/g, '');
}

const entriesById = new Map((await getCollection('blog')).map((entry) => [entry.id, entry]));

const posts = blogLinks
  .map((link) => {
    const slug = slugFromHref(link.href);
    const entry = entriesById.get(slug);
    if (!entry) return null;
    return {
      slug,
      title: entry.data.title || link.title,
      description: entry.data.description,
      pubDate: entry.data.pubDate,
    };
  })
  .filter((post) => post !== null)
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Artikelen over financiële onderwerpen">
  <div class="blog-listing">
    <h1>Blog</h1>
    <p class="intro">Artikelen en nieuws over financiële onderwerpen.</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2>
              <a href={`/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="description">{post.description}</p>
            <time datetime={post.pubDate.toISOString()}>
              {post.pubDate.toLocaleDateString('nl-NL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-listing {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .blog-listing h1 {
    font-size: 2rem;
    color: #1a365d;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: #666;
    margin-bottom: 2rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.5rem 0;
  }
  .post-list h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .post-list h2 a {
    color: #1a365d;
    text-decoration: none;
  }
  .post-list h2 a:hover {
    text-decoration: underline;
  }
  .description {
    color: #4a5568;
    margin-bottom: 0.5rem;
  }
  time {
    font-size: 0.85rem;
    color: #888;
  }
</style>
