---
import PageLayout from '../layouts/PageLayout.astro';

const title = "Van Noors naar Nederlands";
const description = "Van Noors naar Nederlands\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Noors naar Nederlands.\r\n\r\n\r\n\r\n\r\nvar dir=\"no/nl\";";
const htmlContent = "# Van Noors naar Nederlands\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Noors naar Nederlands. var dir=\"no/nl\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Noors naar Nederlands\n\nMet onze tool kun je woorden eenvoudig vertalen van het Noors naar Nederlands. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
