---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HubLinks from '../components/HubLinks.astro';
import { groupVermogenVan } from '../lib/hub-pages';

const title = 'Vermogen van';
const description =
  'Overzicht van alle vermogen-van pagina\'s op FinancieleBegrippen.com — ontdek het vermogen van bekende Nederlanders.';
const pubDate = new Date('2024-02-02');

const entries = await getCollection('blog');
const groups = groupVermogenVan(entries);
---

<PageLayout title={title} description={description} pubDate={pubDate}>
  <p class="hub-page-intro">
    Ontdek het vermogen van bekende personen. Alle namen staan alfabetisch gerangschikt — klik door
    naar het volledige artikel.
  </p>
  <HubLinks groups={groups} />
</PageLayout>
