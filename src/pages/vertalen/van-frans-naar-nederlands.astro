---
import PageLayout from '../../layouts/PageLayout.astro';

const title = "Van Frans naar Nederlands";
const description = "Van Frans naar Nederlands vertalen\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Frans naar Nederlands.\r\n\r\n\r\n\r\n\r\nvar dir";
const htmlContent = "# Van Frans naar Nederlands vertalen\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Frans naar Nederlands. var dir=\"fr/nl\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Frans naar Nederlands\n\nMet onze tool kun je woorden eenvoudig vertalen van het Duits naar het Frans. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken. Heeft u tips voor onze vertaler, laat het ons weten op onze contactpagina.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
