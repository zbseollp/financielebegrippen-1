const title = "Van Nederlands naar Chinees";
const description = "Van Nederlands naar Chinees vertalen\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Nederlands naar Chinees.\r\n\r\n\r\n\r\n\r\nvar";
const htmlContent = "# Van Nederlands naar Chinees vertalen\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Nederlands naar Chinees. var dir=\"nl/zt\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Nederlands naar Chinees\n\nMet onze tool kun je woorden eenvoudig vertalen van het Nederlands naar het Chinees. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken. De Chinese taal wordt ook wel Kantonees genoemd.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
