import PageLayout from '../../layouts/PageLayout.astro';

const title = "Van Nederlands naar Noors";
const description = "Van Nederlands naar Noors vertalen\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Nederlands naar Noors.\r\n\r\n\r\n\r\n\r\nvar dir";
const htmlContent = "# Van Nederlands naar Noors vertalen\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Nederlands naar Noors. var dir=\"nl/no\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Nederlands naar Noors\n\nMet onze tool kun je woorden eenvoudig vertalen van het Nederlands naar het Noors. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
