---
import PageLayout from '../../layouts/PageLayout.astro';

const title = "Van Engels naar Nederlands";
const description = "Van Engels naar Nederlands\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Engels naar Nederlands.\r\n\r\n\r\n\r\n\r\nvar dir=\"en/nl";
const htmlContent = "# Van Engels naar Nederlands\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Engels naar Nederlands. var dir=\"en/nl\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Engels naar Nederlands\n\nMet onze tool kun je woorden eenvoudig vertalen van het Engels naar Nederlands. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
