---
import PageLayout from '../layouts/PageLayout.astro';

const title = "Van Zweeds naar Nederlands";
const description = "Van Zweeds naar Nederlands\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Zweeds naar Nederlands.\r\n\r\n\r\n\r\n\r\nvar dir=\"sv/nl";
const htmlContent = "# Van Zweeds naar Nederlands\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Zweeds naar Nederlands. var dir=\"sv/nl\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Zweeds naar Nederlands\n\nMet onze tool kun je woorden eenvoudig vertalen van het Zweeds naar Nederlands. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
