---
import PageLayout from '../layouts/PageLayout.astro';

const title = "Van Japans naar Nederlands";
const description = "Van Japans naar Nederlands\r\nVertalen kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Japans naar Nederlands.\r\n\r\n\r\n\r\nvar dir=\"ja/nl\";";
const htmlContent = "# Van Japans naar Nederlands\n\n[Vertalen](/vertalen) kan via onze eenvoudige tool. Deze staat reeds ingesteld om te vertalen van Japans naar Nederlands. var dir=\"ja/nl\"; var loc=\"nl\";\n\n[Translator](//imtranslator.net/translation/ \"Translator - imtranslator.net\")\n\n## Woorden vertalen van Japans naar Nederlands\n\nMet onze tool kun je woorden eenvoudig vertalen van het Japans naar Nederlands. Je kunt zelfs zinnen vertalen. De tool is gratis en zoveel als je wilt te gebruiken.";
---

<PageLayout title={title} description={description}>
  <div set:html={htmlContent} />
</PageLayout>
