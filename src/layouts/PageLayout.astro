---
import InnerPageLayout from './InnerPageLayout.astro';
import InnerArticle from '../components/InnerArticle.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
}

const { title, description, pubDate } = Astro.props;
---

<InnerPageLayout title={title} description={description} bodyClass="elementor-36361 hub-index-page">
  <InnerArticle title={title} pubDate={pubDate}>
    <div class="inner-article-content hub-page-content">
      <slot />
    </div>
  </InnerArticle>
</InnerPageLayout>
