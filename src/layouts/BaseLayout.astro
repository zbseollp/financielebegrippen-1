---
import InnerPageLayout from './InnerPageLayout.astro';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass = '' } = Astro.props;
---

<InnerPageLayout title={title} description={description} bodyClass={bodyClass}>
  <main class="site-main">
    <slot />
  </main>
</InnerPageLayout>

<style is:global>
  .site-main {
    min-height: 40vh;
  }
</style>
