---
import InnerPageLayout from './InnerPageLayout.astro';
import InnerArticle from '../components/InnerArticle.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate } = entry.data;
const { id } = entry;

const isVermogenVan = id.startsWith('vermogen-van/');
const isEuroLenen = id.endsWith('-euro-lenen');
const isAchterafBetalen = id.endsWith('-achteraf-betalen');

let displayTitle = title;
let breadcrumbs: { label: string; href?: string }[] | undefined;
let displayDate = pubDate;

if (isVermogenVan) {
  displayTitle = `Vermogen van ${title}`;
  breadcrumbs = [
    { label: 'Vermogen van', href: '/vermogen-van/' },
    { label: title },
  ];
  displayDate = pubDate ?? new Date('2024-01-25');
} else if (isEuroLenen) {
  const amount = id.replace(/-euro-lenen$/, '');
  displayTitle = `${amount} euro lenen`;
  breadcrumbs = [
    { label: 'lenen', href: '/lenen/' },
    { label: amount },
  ];
  displayDate = pubDate ?? new Date('2024-02-29');
} else if (isAchterafBetalen) {
  displayTitle = `${title} achteraf betalen`;
  breadcrumbs = [
    { label: 'Achteraf betalen', href: '/achteraf-betalen/' },
    { label: title },
  ];
  displayDate = pubDate ?? new Date('2024-02-29');
}
---

<InnerPageLayout title={displayTitle} description={description} bodyClass="elementor-36361">
  <InnerArticle
    title={displayTitle}
    pubDate={displayDate}
    excludeSlug={id}
    breadcrumbs={breadcrumbs}
  >
    <div
      class:list={[
        'prose',
        { 'vermogen-van-article': isVermogenVan },
        { 'euro-lenen-article': isEuroLenen },
        { 'achteraf-betalen-article': isAchterafBetalen },
      ]}
    >
      <slot />
    </div>
  </InnerArticle>
</InnerPageLayout>
